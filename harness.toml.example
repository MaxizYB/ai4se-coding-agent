# Example harness config. Copy to harness.toml and edit. All fields optional.
[scope]
project_root = "."
allowed_write_dirs = ["src"]

[guardrails]
dangerous_shell_patterns = ["rm\\s+-rf?", "git\\s+push\\s+(-f|--force)", "DROP\\s+TABLE", ":\\(\\)\\s*\\{"]
network_commands = ["pip install", "npm install", "curl", "wget"]
fail_closed_when_noninteractive = true

[budget]
max_iterations = 20
max_parse_failures = 5
stuck_repeat_n = 3
stuck_no_progress_m = 4
test_timeout_s = 30

[feedback]
hint_history_lines = 8

[context]
max_history = 8
# M1: conversation compaction. When total history chars exceed
# `compact_threshold`, older turns fold into ONE structured system message and
# the last `keep_recent` turns stay verbatim (deterministic, no LLM).
compact_threshold = 6000
keep_recent = 6
# M3: @mention file pull. When the last user message references `@<path>`
# files, their content is pulled into context: up to `mention_max_files` unique
# files, each capped at `mention_max_chars` (larger files are truncated with a
# marker). Missing files are skipped silently.
mention_max_chars = 8000
mention_max_files = 3

# Sandbox: HARD execution-boundary gate (Guardrail asks a human; Sandbox says no
# regardless). Writes must land under a write-root; denylisted commands never
# run; network egress is gated by `network`.
[sandbox]
# network = "allowlist" | "offline" | "open"
network = "allowlist"
network_allow = []  # tools permitted without asking when network = "allowlist"
denied_commands = ["rm\\s+-rf\\s+/", "mkfs", "dd\\s+.*\\bof=", ":\\(\\)\\s*\\{", ">\\s*/dev/sd", "sudo"]
write_roots = ["src"]
containerize = false
container_image = "python:3.11-slim"

# Governance: write-before-apply diff preview + approval gate.
#   diff_preview = "ask"    -> show the diff and require approval before write/edit
#                              (fail-closed under a non-interactive approver)
#              | "always"   -> show the diff then auto-apply (no prompt)
#              | "never"    -> apply silently (no preview, no prompt)
[governance]
diff_preview = "ask"
